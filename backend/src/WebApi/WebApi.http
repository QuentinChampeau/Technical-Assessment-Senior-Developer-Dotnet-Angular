### Create an expense with invalid data - should return 400

POST {{WebApi_HostAddress}}/expenses
Content-Type: application/json

{
    "description": "",
    "amount": 0,
    "category": "",
    "date": "2026-04-01T00:00:00.000Z"
}

> {%
    client.test("POST /expenses (invalid) - Status code is 400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400 Bad Request");
    });

    client.test("POST /expenses (invalid) - Response contains validation errors", function () {
        client.assert(response.body.errors != null, "Expected errors in response body");
    });
%}

### Get all expenses - first page with default sorting

GET {{WebApi_HostAddress}}/expenses?page=1&pageSize=10
Accept: application/json

> {%
    client.test("GET /expenses - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("GET /expenses - Response is a valid paged result", function () {
        const body = response.body;
        client.assert(Array.isArray(body.items), "items should be an array");
        client.assert(body.items.length > 0, "items should not be empty");
        client.assert(typeof body.totalCount === "number", "totalCount should be a number");
        client.assert(typeof body.totalPages === "number", "totalPages should be a number");
        client.assert(body.page === 1, "page should be 1");
        client.assert(body.pageSize === 10, "pageSize should be 10");
    });
%}

### Get expenses filtered by category

GET {{WebApi_HostAddress}}/expenses?page=1&pageSize=10&category=Meals
Accept: application/json

> {%
    client.test("GET /expenses?category=Meals - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("GET /expenses?category=Meals - All returned expenses belong to Meals", function () {
        response.body.items.forEach(function (item) {
            client.assert(item.category === "Meals", "Expected category Meals, got: " + item.category);
        });
    });
%}

### Get expenses filtered by search keyword

GET {{WebApi_HostAddress}}/expenses?page=1&pageSize=10&search=lunch
Accept: application/json

> {%
    client.test("GET /expenses?search=lunch - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("GET /expenses?search=lunch - Returned descriptions contain the keyword", function () {
        response.body.items.forEach(function (item) {
            client.assert(
                item.description.toLowerCase().includes("lunch"),
                "Expected description to contain 'lunch', got: " + item.description
            );
        });
    });
%}

### Get expenses sorted by amount ascending

GET {{WebApi_HostAddress}}/expenses?page=1&pageSize=10&sortBy=amount&sortDirection=asc
Accept: application/json

> {%
    client.test("GET /expenses sorted by amount asc - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("GET /expenses sorted by amount asc - Items are in ascending order", function () {
        const items = response.body.items;
        for (var i = 1; i < items.length; i++) {
            client.assert(items[i].amount >= items[i - 1].amount, "Items not sorted by amount asc at index " + i);
        }
    });
%}

### Get a specific expense by ID

GET {{WebApi_HostAddress}}/expenses/{{ExpenseId}}
Accept: application/json

> {%
    client.test("GET /expenses/{id} - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("GET /expenses/{id} - Response matches the created expense", function () {
        const body = response.body;
        client.assert(body.id === client.global.get("ExpenseId"), "id mismatch");
        client.assert(body.description === "Team lunch at the office", "description mismatch");
        client.assert(body.amount === 42.50, "amount mismatch");
        client.assert(body.category === "Meals", "category mismatch");
    });
%}

