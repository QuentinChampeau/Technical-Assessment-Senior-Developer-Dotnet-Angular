GET {{WebApi_HostAddress}}/expenses/00000000-0000-0000-0000-000000000000
Accept: application/json

> {%
    client.test("GET /expenses/{id} (not found) - Status code is 404 Not Found", function () {
        client.assert(response.status === 404, "Expected 404 Not Found");
    });
%}

### Update the captured expense

PUT {{WebApi_HostAddress}}/expenses/{{ExpenseId}}
Content-Type: application/json

{
    "description": "Team lunch at the office (updated)",
    "amount": 55.00,
    "category": "Meals",
    "date": "2026-04-01T12:00:00.000Z"
}

> {%
    client.test("PUT /expenses/{id} - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("PUT /expenses/{id} - Response reflects updated values", function () {
        const body = response.body;
        client.assert(body.description === "Team lunch at the office (updated)", "description not updated");
        client.assert(body.amount === 55.00, "amount not updated");
    });
%}

### Get audit history for the updated expense

GET {{WebApi_HostAddress}}/expenses/{{ExpenseId}}/history
Accept: application/json

> {%
    client.test("GET /expenses/{id}/history - Status code is 200 OK", function () {
        client.assert(response.status === 200, "Expected 200 OK");
    });

    client.test("GET /expenses/{id}/history - Contains Created and Updated audit entries", function () {
        const body = response.body;
        client.assert(Array.isArray(body), "Expected an array of audit entries");
        client.assert(body.length >= 2, "Expected at least 2 audit entries (Created + Updated)");
        const actions = body.map(function (e) { return e.action; });
        client.assert(actions.indexOf("Created") !== -1, "Missing Created audit entry");
        client.assert(actions.indexOf("Updated") !== -1, "Missing Updated audit entry");
    });

    client.test("GET /expenses/{id}/history - Each entry has required fields", function () {
        response.body.forEach(function (entry) {
            client.assert(entry.id != null, "audit entry id is missing");
            client.assert(entry.action != null, "audit entry action is missing");
            client.assert(entry.changesJson != null, "audit entry changesJson is missing");
            client.assert(entry.createdAtUtc != null, "audit entry createdAtUtc is missing");
        });
    });
%}

