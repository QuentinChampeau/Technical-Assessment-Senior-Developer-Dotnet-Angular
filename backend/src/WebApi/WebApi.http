@WebApi_HostAddress = http://localhost:5195
@ExpenseId = ""

### Get user info
GET {{WebApi_HostAddress}}/users/me
Accept: application/json

> {%
    client.test("Get user info - Status code is 200", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });


    client.test("Get user info - Response Content-Type is application/json", function () {
        const contentTypeValue = response.headers.valueOf("Content-Type")
        const contentTypes = contentTypeValue.split('; ')

        client.assert(contentTypes.filter(function (v) {
            return v === "application/json"
        }).length > 0, "Response Content-Type is not application/json");
        client.global.set("CompanyId", response.body.company_id);
        client.global.set("EmployeeId", response.body.id);
    });
%}

### Create a Meals expense (captures ExpenseId for subsequent requests)

POST {{WebApi_HostAddress}}/expenses
Content-Type: application/json

{
    "description": "Team lunch at the office",
    "amount": 42.50,
    "category": "Meals",
    "date": "2026-04-01T12:00:00.000Z"
}

> {%
    client.test("POST /expenses - Status code is 201 Created", function () {
        client.assert(response.status === 201, "Expected 201 Created");
    });

    client.test("POST /expenses - Response body contains a valid expense", function () {
        const body = response.body;
        client.assert(body.id != null && body.id.length > 0, "id is missing");
        client.assert(body.description === "Team lunch at the office", "description mismatch");
        client.assert(body.amount === 42.50, "amount mismatch");
        client.assert(body.category === "Meals", "category mismatch");
        client.assert(body.createdAtUtc != null, "createdAtUtc is missing");
        client.assert(body.updatedAtUtc != null, "updatedAtUtc is missing");
        client.global.set("ExpenseId", body.id);
    });

    client.test("POST /expenses - Location header points to the created resource", function () {
        const location = response.headers.valueOf("Location");
        client.assert(location != null && location.length > 0, "Location header is missing");
        client.assert(location.includes("/expenses/"), "Location header does not reference /expenses/");
    });
%}

